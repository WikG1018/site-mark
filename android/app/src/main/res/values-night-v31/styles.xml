<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31+) SplashScreen configuration for dark mode.
         Black background matches the dark Flutter first frame; the icon is
         the branded splash disc (drawable/splash_icon.xml), whose green disc
         carries the same white glyph in both modes. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#176B55</item>
        <item name="android:postSplashScreenTheme">@style/NormalTheme</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Same purpose as the base NormalTheme; redeclared so resource
         resolution keeps working when this qualifier directory wins. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
