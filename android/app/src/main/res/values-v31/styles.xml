<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31+) SplashScreen configuration for light mode.
         The white windowSplashScreenBackground hands off to the light
         Flutter first frame without a color flash; the icon is the branded
         splash disc (drawable/splash_icon.xml), not the full launcher icon,
         so it does not read as a blown-up launcher icon.
         postSplashScreenTheme switches the window away from the splash state
         explicitly once the Flutter engine draws its first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#176B55</item>
        <item name="android:postSplashScreenTheme">@style/NormalTheme</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Same purpose as the base NormalTheme; redeclared so resource
         resolution keeps working when this qualifier directory wins. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
